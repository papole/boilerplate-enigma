{
    "name": "nestjs-control-de-stock-basico",
    "version": "1.0.0",
    "description": "Boilerplate-Control de Stock",
    "scripts": {
        "start": "nest start",
        "start:dev": "nest start --watch",
        "build": "rm -rf dist && nest build",
        "format": "prettier --write \"src/**/*.ts\"",
        "g:feature": "nest g resource",
        "migration:generate": "npm run build && npx typeorm migration:generate -d ./dist/typeorm.config.js",
        "migration:run": "npm run build && npx typeorm migration:run -d ./dist/typeorm.config.js",
        "migration:revert": "npm run build && npx typeorm migration:revert -d ./dist/typeorm.config.js",
        "test": "jest",
        "test:e2e": "jest --config ./test/jest-e2e.json"
    },
    "dependencies": {
        "@nestjs/common": "^10.0.0",
        "@nestjs/core": "^10.0.0",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^10.0.0",
        "@nestjs/typeorm": "^10.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "dotenv": "^16.3.1",
        "mysql2": "^3.14.0",
        "pg": "^8.11.0",
        "reflect-metadata": "^0.1.13",
        "rxjs": "^7.8.0",
        "typeorm": "^0.3.22",
        "typeorm-naming-strategies": "^4.1.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.0",
        "@nestjs/schematics": "^10.0.0",
        "@nestjs/testing": "^10.4.17",
        "@types/jest": "^29.5.14",
        "@types/node": "^22.14.1",
        "@types/supertest": "^6.0.3",
        "jest": "^29.7.0",
        "prettier": "^2.8.0",
        "supertest": "^7.1.0",
        "ts-jest": "^29.3.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typeorm-ts-node-esm": "^0.3.20",
        "typescript": "^5.2.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
